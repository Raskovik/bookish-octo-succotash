# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Needed only for gem purchases (/gems) and its Stripe webhook — the rest
# of the app runs fine without these. See README "Step 6: Set up Stripe
# test keys" for where to get them. SUPABASE_SERVICE_ROLE_KEY is from the
# same Supabase API settings page as the two keys above — NEVER prefix it
# with NEXT_PUBLIC_ or let it reach the browser, it bypasses RLS entirely.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
